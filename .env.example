# Google Gemini API Keys
# Obtén tus API keys en: https://makersuite.google.com/app/apikey
# Puedes crear hasta 3 keys para rotación automática cuando una agota su cuota
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_API_KEY_2=tu_segunda_api_key
GEMINI_API_KEY_3=tu_tercera_api_key

# Modelo de Gemini (opcional, por defecto: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Railway: Agrega estas variables en Railway Dashboard > Variables
# No necesitas archivo .env en producción, Railway las inyecta automáticamente
